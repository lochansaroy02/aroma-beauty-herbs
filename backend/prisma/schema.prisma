// ============================================================================
//  Barber Syndicate — Prisma schema
//  Ported from prisma.txt (reverse-engineered from the Laravel DB).
//
//  Conventions:
//   - Model names are PascalCase; @@map ties each to its real table.
//   - Column names are kept snake_case to match the existing database exactly.
//   - Money is modelled as Decimal(precision, scale).
//   - `created_by_id` / `updated_by_id` are audit columns → plain Int? (they
//     reference users but are left un-related to avoid dozens of back-relations).
//   - Ported to PostgreSQL: @db.LongText → @db.Text, @db.TinyInt → @db.SmallInt.
// ============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // The project compiles to CommonJS (no "type": "module" in package.json).
  // Without this the client emits `import.meta.url`, which makes Node load the
  // compiled file as ESM and crash on its own `exports` assignments.
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Enums ───────────────────────────

enum ProductType {
  simple
  variable
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum CouponType {
  fixed
  percent
}

enum StockTxnType {
  IN
  OUT
  ADJUSTMENT
}

// ─────────────────────────── Users & Auth ───────────────────────────

model User {
  id                Int       @id @default(autoincrement())
  name              String?
  email             String    @unique
  phone             String?
  email_verified_at DateTime?
  password          String
  show_password     String?
  role_as           String?   // "Admin" | "Customer"
  status            String?   @default("1")
  otp               String?   // bcrypt hash of the 6-digit code, never the code itself
  otp_expires_at    DateTime?
  otp_attempts      Int?      @default(0) // failed verifies for the current code
  otp_last_sent_at  DateTime? // drives the resend cooldown
  remember_token    String?   @db.VarChar(100)
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt
  deleted_at        DateTime?

  addresses         UserAddress[]
  orders            Order[]
  order_histories   OrderStatusHistory[]
  cart_items        CartItem[]
  wishlists         Wishlist[]
  reviews           ProductReview[]

  @@map("users")
}

model UserAddress {
  id             Int       @id @default(autoincrement())
  user_id        Int
  address_title  String?   // Home, Office, etc.
  first_name     String
  last_name      String
  email          String
  phone          String
  address_line_1 String
  address_line_2 String?
  city           String
  state          String
  zip_code       String
  country        String    @default("India")
  is_default     Boolean   @default(false)
  created_at     DateTime? @default(now())
  updated_at     DateTime? @updatedAt

  user           User      @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("user_addresses")
}

// ─────────────────────────── Catalog: taxonomy ───────────────────────────

model Category {
  id                   Int       @id @default(autoincrement())
  created_by_id        Int?
  updated_by_id        Int?
  parent_id            Int?
  level                Int?      @default(1)
  name                 String?
  slug                 String?
  meta_title           String?
  meta_description     String?   @db.VarChar(300)
  category_description String?   @db.Text
  order_by             Int?
  status               Int?      @default(1)
  is_featured          Boolean   @default(false)   // homepage feature flag
  show_in_menu         Boolean   @default(true)    // shop page / hover menu
  created_at           DateTime? @default(now())
  updated_at           DateTime? @updatedAt
  deleted_at           DateTime?

  parent               Category?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children             Category[] @relation("CategoryTree")
  products             Product[]

  @@map("categories")
}

model Brand {
  id            Int       @id @default(autoincrement())
  created_by_id Int?
  updated_by_id Int?
  name          String?
  slug          String?
  status        Int?      @default(1)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
  deleted_at    DateTime?

  products      Product[]

  @@map("brands")
}

model Attribute {
  id                 Int       @id @default(autoincrement())
  name               String?
  slug               String?
  status             Int?      @default(1)
  created_by_id      Int?
  updated_by_id      Int?
  created_at         DateTime? @default(now())
  updated_at         DateTime? @updatedAt
  deleted_at         DateTime?

  values             AttributeValue[]
  variant_attributes ProductVariantAttribute[]

  @@map("attributes")
}

model AttributeValue {
  id                 Int       @id @default(autoincrement())
  attribute_id       Int?
  value              String?
  color_code         String?
  slug               String?
  status             Int?      @default(1)
  created_by_id      Int?
  updated_by_id      Int?
  created_at         DateTime? @default(now())
  updated_at         DateTime? @updatedAt
  deleted_at         DateTime?

  attribute          Attribute? @relation(fields: [attribute_id], references: [id])
  variant_attributes ProductVariantAttribute[]

  @@map("attribute_values")
}

model TaxRate {
  id         Int       @id @default(autoincrement())
  rate       Decimal   @db.Decimal(5, 2)
  status     Boolean   @default(true)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  @@map("tax_rates")
}

// ─────────────────────────── Catalog: products ───────────────────────────

model Product {
  id                 Int         @id @default(autoincrement())
  product_code       String      @unique
  product_name       String
  slug               String      @unique
  meta_title         String?
  meta_description   String?     @db.VarChar(300)
  brand_id           Int?
  category_id        Int?
  product_type       ProductType @default(simple)
  short_description  String?     @db.Text
  description        String?     @db.Text
  specific_item_info String?     @db.Text
  how_to_use         String?     @db.Text
  badge_style        String?
  status             Int         @default(1)  // 1: Active, 0: Inactive
  is_featured        Boolean     @default(false)
  is_combo           Boolean     @default(false)
  tax_rate           Decimal?    @db.Decimal(8, 2)
  order_by           Int?
  created_by_id      Int?
  updated_by_id      Int?
  created_at         DateTime?   @default(now())
  updated_at         DateTime?   @updatedAt
  deleted_at         DateTime?

  brand              Brand?      @relation(fields: [brand_id], references: [id])
  category           Category?   @relation(fields: [category_id], references: [id])
  variants           ProductVariant[]
  cart_items         CartItem[]
  order_items        OrderItem[]
  wishlists          Wishlist[]
  reviews            ProductReview[]
  home_reviews       HomeCustomerReview[]
  home_videos        HomeVideoSection[]
  stock_transactions StockTransaction[]

  @@index([brand_id])
  @@index([category_id])
  @@map("products")
}

model ProductVariant {
  id             Int       @id @default(autoincrement())
  product_id     Int
  sku            String    @unique
  variation_name String?
  status         Int       @default(1)
  created_at     DateTime? @default(now())
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?

  product            Product           @relation(fields: [product_id], references: [id])
  price              ProductPrice?
  inventory          ProductInventory?
  attributes         ProductVariantAttribute[]
  cart_items         CartItem[]
  order_items        OrderItem[]
  stock_transactions StockTransaction[]

  @@index([product_id])
  @@map("product_variants")
}

model ProductVariantAttribute {
  id                 Int       @id @default(autoincrement())
  variant_id         Int
  attribute_id       Int
  attribute_value_id Int
  created_at         DateTime? @default(now())
  updated_at         DateTime? @updatedAt

  variant            ProductVariant @relation(fields: [variant_id], references: [id])
  attribute          Attribute      @relation(fields: [attribute_id], references: [id])
  attribute_value    AttributeValue @relation(fields: [attribute_value_id], references: [id])

  @@index([variant_id])
  @@map("product_variant_attributes")
}

model ProductPrice {
  id             Int       @id @default(autoincrement())
  variant_id     Int       @unique
  mrp            Decimal   @default(0) @db.Decimal(15, 2)
  sale_price     Decimal   @default(0) @db.Decimal(15, 2)
  discount       Decimal   @default(0) @db.Decimal(15, 2)
  tax_percentage Decimal   @default(0) @db.Decimal(5, 2)
  created_at     DateTime? @default(now())
  updated_at     DateTime? @updatedAt

  variant        ProductVariant @relation(fields: [variant_id], references: [id])

  @@map("product_prices")
}

model ProductInventory {
  id              Int       @id @default(autoincrement())
  variant_id      Int       @unique
  stock_qty       Int       @default(0)
  reserved_qty    Int       @default(0)
  low_stock_alert Int       @default(0)
  created_at      DateTime? @default(now())
  updated_at      DateTime? @updatedAt

  variant         ProductVariant @relation(fields: [variant_id], references: [id])

  @@map("product_inventory")
}

model StockTransaction {
  id             Int          @id @default(autoincrement())
  variant_id     Int
  product_id     Int?
  type           StockTxnType
  reference_type String?      // manual, order, purchase, return, system
  reference_id   Int?
  qty            Decimal      @db.Decimal(15, 2)
  stock_before   Decimal      @db.Decimal(15, 2)
  stock_after    Decimal      @db.Decimal(15, 2)
  notes          String?      @db.Text
  created_by_id  Int?
  created_at     DateTime?    @default(now())
  updated_at     DateTime?    @updatedAt

  variant        ProductVariant @relation(fields: [variant_id], references: [id])
  product        Product?       @relation(fields: [product_id], references: [id])

  @@map("stock_transactions")
}

// ─────────────────────────── Cart & Wishlist ───────────────────────────

model CartItem {
  id                 Int       @id @default(autoincrement())
  user_id            Int?
  session_id         String?
  product_id         Int
  product_variant_id Int?
  quantity           Int       @default(1)
  price              Decimal?  @db.Decimal(15, 2)
  created_at         DateTime? @default(now())
  updated_at         DateTime? @updatedAt

  user               User?           @relation(fields: [user_id], references: [id])
  product            Product         @relation(fields: [product_id], references: [id])
  variant            ProductVariant? @relation(fields: [product_variant_id], references: [id])

  @@unique([user_id, product_id, product_variant_id], name: "cart_items_user_product_variant_unique")
  @@index([user_id])
  @@index([session_id])
  @@index([product_id])
  @@index([product_variant_id])
  @@map("cart_items")
}

model Wishlist {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  session_id String?
  product_id Int
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  user       User?    @relation(fields: [user_id], references: [id])
  product    Product  @relation(fields: [product_id], references: [id])

  @@map("wishlists")
}

// ─────────────────────────── Orders ───────────────────────────

model Order {
  id                  Int           @id @default(autoincrement())
  order_number        String        @unique
  user_id             Int?
  status              OrderStatus   @default(pending)
  billing_first_name  String
  billing_last_name   String
  billing_email       String
  billing_phone       String
  billing_address     String
  billing_city        String
  billing_state       String
  billing_zip         String
  billing_country     String        @default("India")
  subtotal            Decimal       @db.Decimal(10, 2)
  discount            Decimal       @default(0) @db.Decimal(10, 2)
  shipping            Decimal       @default(0) @db.Decimal(10, 2)
  tax_total           Decimal       @default(0) @db.Decimal(10, 2)
  total               Decimal       @db.Decimal(10, 2)
  coupon_id           Int?
  coupon_code         String?
  payment_method      String        @default("razorpay")
  payment_status      PaymentStatus @default(pending)
  razorpay_payment_id String?
  razorpay_order_id   String?
  payment_error       String?       @db.Text
  payment_remarks     String?       @db.Text
  notes               String?       @db.Text
  created_at          DateTime?     @default(now())
  updated_at          DateTime?     @updatedAt

  user                User?                @relation(fields: [user_id], references: [id])
  coupon              Coupon?              @relation(fields: [coupon_id], references: [id])
  items               OrderItem[]
  status_histories    OrderStatusHistory[]

  @@index([user_id])
  @@index([coupon_id])
  @@map("orders")
}

model OrderItem {
  id                 Int       @id @default(autoincrement())
  order_id           Int
  product_id         Int
  product_variant_id Int?
  product_name       String
  variant_details    String?
  quantity           Int
  rate_include_gst   Decimal?  @db.Decimal(10, 2)
  rate_exclude_gst   Decimal?  @db.Decimal(10, 2)
  gst_rate           Decimal?  @db.Decimal(10, 2)
  discount           Decimal?  @db.Decimal(10, 2)
  include_gst_total  Decimal?  @db.Decimal(10, 2)
  exclude_gst_total  Decimal?  @db.Decimal(10, 2)
  tax_rate           Decimal   @default(0) @db.Decimal(8, 2)
  tax_amount         Decimal   @default(0) @db.Decimal(10, 2)
  unit_price         Decimal   @db.Decimal(10, 2)
  total_price        Decimal   @db.Decimal(10, 2)
  created_at         DateTime? @default(now())
  updated_at         DateTime? @updatedAt

  order              Order           @relation(fields: [order_id], references: [id])
  product            Product         @relation(fields: [product_id], references: [id])
  variant            ProductVariant? @relation(fields: [product_variant_id], references: [id])

  @@index([order_id])
  @@index([product_id])
  @@index([product_variant_id])
  @@map("order_items")
}

model OrderStatusHistory {
  id         Int       @id @default(autoincrement())
  order_id   Int
  status     String
  remarks    String?   @db.Text
  user_id    Int?
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  order      Order  @relation(fields: [order_id], references: [id])
  user       User?  @relation(fields: [user_id], references: [id])

  @@index([order_id])
  @@index([user_id])
  @@map("order_status_histories")
}

model Coupon {
  id                     Int        @id @default(autoincrement())
  name                   String?    @db.VarChar(150)
  code                   String?    @unique @db.VarChar(50)
  type                   CouponType @default(fixed)
  value                  Decimal    @default(0) @db.Decimal(10, 2)
  min_spend              Decimal?   @db.Decimal(10, 2)
  max_spend              Decimal?   @db.Decimal(10, 2)
  usage_limit_per_coupon Int?
  usage_limit_per_user   Int?
  usage_count            Int        @default(0)
  start_date             DateTime?
  end_date               DateTime?
  description            String?    @db.Text
  status                 Int        @default(1)
  created_by_id          Int?
  created_at             DateTime?  @default(now())
  updated_at             DateTime?  @updatedAt
  deleted_at             DateTime?

  orders                 Order[]

  @@map("coupons")
}

// ─────────────────────────── Reviews ───────────────────────────

model ProductReview {
  id                   Int       @id @default(autoincrement())
  product_id           Int
  user_id              Int
  rating               Int       @db.SmallInt   // 1..5
  title                String?
  review               String?   @db.Text
  is_verified_purchase Boolean   @default(false)
  status               Boolean   @default(true) // approved / visible
  created_at           DateTime? @default(now())
  updated_at           DateTime? @updatedAt

  product              Product @relation(fields: [product_id], references: [id])
  user                 User    @relation(fields: [user_id], references: [id])

  @@unique([product_id, user_id])
  @@map("product_reviews")
}

// ─────────────────────────── Content / Blog ───────────────────────────

model Blog {
  id                Int       @id @default(autoincrement())
  created_by_id     Int?
  blog_category_id  Int?
  name              String?
  slug              String?
  meta_title        String?
  meta_description  String?   @db.VarChar(300)
  tags              String?   @db.Text
  image_url         String?   @db.Text
  short_description String?   @db.Text
  description       String?   @db.Text
  status            Int       @default(0)
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt
  deleted_at        DateTime?

  blog_category     BlogCategory? @relation(fields: [blog_category_id], references: [id])

  @@map("blogs")
}

model BlogCategory {
  id            Int       @id @default(autoincrement())
  created_by_id Int?
  name          String?   @db.VarChar(150)
  slug          String?   @db.VarChar(150)
  status        Int       @default(0)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
  deleted_at    DateTime?

  blogs         Blog[]

  @@map("blog_categories")
}

model Policy {
  id                      Int       @id @default(autoincrement())
  created_by_id           Int?
  name                    String?
  slug                    String?
  short_description       String?   @db.Text
  description             String?   @db.Text
  is_terms_and_conditions Int       @default(0)
  is_privacy_policy       Int       @default(0)
  status                  Int       @default(0)
  created_at              DateTime? @default(now())
  updated_at              DateTime? @updatedAt
  deleted_at              DateTime?

  @@map("policies")
}

model ContactForm {
  id           Int       @id @default(autoincrement())
  name         String?
  email        String?
  phone        String?
  country_code String?
  subject      String?
  message      String?   @db.Text
  status       String?   @default("Pending")
  created_at   DateTime? @default(now())
  updated_at   DateTime? @updatedAt
  deleted_at   DateTime?

  @@map("contact_forms")
}

model Subscriber {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  status     Int       @default(1)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  @@map("subscribers")
}

// ─────────────────────────── Storefront / Home settings ───────────────────────────

model Banner {
  id            Int       @id @default(autoincrement())
  created_by_id Int?
  updated_by_id Int?
  name          String?
  slug          String?
  url           String?
  status        Int?      @default(1)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
  deleted_at    DateTime?

  @@map("banners")
}

model SmallBanner {
  id            Int       @id @default(autoincrement())
  created_by_id Int?
  updated_by_id Int?
  name          String?
  slug          String?
  url           String?
  order_by      Int       @default(0)
  status        Int?      @default(1)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
  deleted_at    DateTime?

  @@map("small_banners")
}

model TopBarText {
  id            Int       @id @default(autoincrement())
  created_by_id Int?
  updated_by_id Int?
  name          String?
  url           String?
  status        Int?      @default(1)
  is_featured   Int?      @default(0)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
  deleted_at    DateTime?

  @@map("top_bar_texts")
}

model HomeCustomerReview {
  id            Int       @id @default(autoincrement())
  created_by_id Int?
  updated_by_id Int?
  product_id    Int?
  title         String?
  review        String?   @db.Text
  person_name   String?
  rating        Int?      @default(1)
  status        Int?      @default(1)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
  deleted_at    DateTime?

  product       Product?  @relation(fields: [product_id], references: [id])

  @@map("home_customer_reviews")
}

model HomeProductSection {
  id            Int       @id @default(autoincrement())
  created_by_id Int?
  updated_by_id Int?
  product_ids   Json?     // array of product ids
  title         String?
  order_by      Int?      @default(0)
  status        Int?      @default(1)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
  deleted_at    DateTime?

  @@map("home_product_sections")
}

model HomeVideoSection {
  id            Int       @id @default(autoincrement())
  created_by_id Int?
  updated_by_id Int?
  title         String?
  subtitle      String?   // hero standfirst under the title
  url           String?   // where the hero click goes
  cta_label     String?   // button text; defaults to "Shop now" when empty
  product_id    Int?
  order_by      Int?      @default(0)
  status        Int?      @default(1)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
  deleted_at    DateTime?

  product       Product?  @relation(fields: [product_id], references: [id])

  @@map("home_video_sections")
}

/// The scrolling text bands between homepage sections.
model HomeStrip {
  id            Int       @id @default(autoincrement())
  created_by_id Int?
  updated_by_id Int?
  text          String
  direction     String    @default("left") // "left" | "right"
  tone          String    @default("ink")  // "ink" | "leaf" — which band colour
  speed         Int?                       // seconds per loop; null = derive from length
  order_by      Int       @default(0)
  status        Int       @default(1)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
  deleted_at    DateTime?

  @@map("home_strips")
}

/**
 * Homepage composition. One row per block, with a fixed `key` — this is a
 * layout switch, not a page builder, so the set of blocks is closed and only
 * their order, visibility and variant are editable.
 *
 * `layout` is interpreted per key (hero: full|contained|split, tiles:
 * three|two|feature, featured: row|grid), which keeps one table serving all of
 * them instead of a column per section.
 */
model HomeSection {
  id         Int       @id @default(autoincrement())
  key        String    @unique // announcement | hero | strip_a | featured | strip_b | tiles
  position   Int       @default(0)
  is_visible Boolean   @default(true)
  layout     String?
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  @@map("home_sections")
}

/**
 * Contact-form enquiries.
 *
 * Stored as well as emailed, deliberately: email is best-effort — a bounced
 * send, a full inbox or a spam folder would otherwise lose a customer's message
 * with nothing to recover it from. The row is the record; the email is the
 * notification.
 */
model ContactMessage {
  id         Int       @id @default(autoincrement())
  name       String
  email      String
  phone      String?
  subject    String?
  message    String    @db.Text
  /** Whether the notification email actually went out. */
  notified   Boolean   @default(false)
  is_handled Boolean   @default(false)
  ip_hash    String?   @db.VarChar(64)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  @@index([created_at])
  @@map("contact_messages")
}

/**
 * Runtime settings an admin can change without a redeploy.
 *
 * Deliberately tiny and key/value: these are switches, not configuration with
 * structure. Anything that needs a shape of its own gets its own table.
 * A key that is absent falls back to its .env default, so the database only
 * ever holds a deliberate override.
 */
model AppSetting {
  key        String    @id
  value      String
  updated_by Int?
  updated_at DateTime? @updatedAt

  @@map("app_settings")
}

// ─────────────────────────── Analytics ───────────────────────────

model PageVisit {
  id            Int       @id @default(autoincrement())
  visitor_id    String?   @db.VarChar(64)   // cookie/hash — for unique visitors
  path          String?   @db.VarChar(255)
  referrer      String?   @db.VarChar(500)
  referrer_host String?   @db.VarChar(191)  // referrer domain, for grouping
  device        String?   @db.VarChar(20)   // mobile | tablet | desktop
  user_agent    String?   @db.VarChar(500)
  ip_hash       String?   @db.VarChar(64)   // salted hash, never the raw IP
  created_at    DateTime? @default(now())

  @@index([visitor_id])
  @@index([created_at])
  @@map("page_visits")
}

// ─────────────────────────── Media (Spatie Media Library) ───────────────────────────
// Polymorphic: (model_type, model_id) points at any owning row. Prisma has no
// native polymorphic relations, so these are plain scalar fields + an index.

model Media {
  id                     Int       @id @default(autoincrement())
  model_type             String
  model_id               Int
  uuid                   String?   @unique
  collection_name        String
  name                   String
  file_name              String
  mime_type              String?
  disk                   String
  conversions_disk       String?
  size                   Int
  manipulations          Json
  custom_properties      Json
  generated_conversions  Json
  responsive_images      Json
  order_column           Int?
  created_at             DateTime?
  updated_at             DateTime?

  @@index([model_type, model_id])
  @@index([order_column])
  @@map("media")
}
