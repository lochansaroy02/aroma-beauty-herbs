# ═══════════════════════════════════════════════════════════════════════════
#  Aroma Beauty Herbs — backend configuration TEMPLATE
#
#  Copy to .env and fill in:  cp .env.example .env
#
#  Every key here is read by src/lib/env.ts. That file is the contract: a name
#  not listed there is ignored no matter how sensible it looks.
#
#  Full notes for every variable: .env-instruction.md
#
#  Only DATABASE_URL and JWT_SECRET are required; the rest have defaults.
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────── 1. Runtime ────────────────────────────────
# "production" is stricter: unconfigured mail throws instead of printing codes.
NODE_ENV="development"
PORT=8080
# Origin of the Next.js app. Set a real domain in production, never "*".
CORS_ORIGIN="http://localhost:3000"


# ─────────────────────────────── 2. Database ───────────────────────────────
# REQUIRED. Hosted providers usually need ?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/abh"


# ────────────────────────────── 3. Auth / JWT ──────────────────────────────
# REQUIRED. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"


# ────────────────────────────── 4. Branding ────────────────────────────────
APP_NAME="Aroma Beauty Herbs"
APP_URL="http://localhost:3000"


# ──────────────────────── 5. Email (OTP delivery) ──────────────────────────
# Leave SMTP_HOST empty to print codes to the console (development only).
# Gmail: SMTP_PASSWORD must be a 16-character App Password, and MAIL_FROM must
# be the same address as SMTP_USER. See .env-instruction.md for providers with
# proper deliverability (SES, Resend, Brevo, Postmark).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Aroma Beauty Herbs <you@example.com>"
MAIL_REPLY_TO=""


# ─────────────────────── 6. Media storage (local disk) ─────────────────────
# Files are written under MEDIA_ROOT and served at
# <MEDIA_BASE_URL>/media/<folder>/<file>.
# On a VPS: absolute path OUTSIDE the deploy directory, or a redeploy wipes it.
#   sudo mkdir -p /var/www/aroma/media && sudo chown -R $USER /var/www/aroma/media
MEDIA_ROOT="./media"
# Must be an origin a browser can resolve. Keep in sync with the frontend's
# MEDIA_BASE_URL, which next/image uses to allow the host.
MEDIA_BASE_URL="http://localhost:8080"


# ────────────────────────── 7. Payments (Razorpay) ─────────────────────────
# Until KEY_ID looks like rzp_test_… or rzp_live_…, checkout records orders but
# marks them awaiting payment. The webhook secret is separate and easy to miss:
# while it is blank, every webhook call is rejected.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""


# ──────────────────────────── 8. Order handling ────────────────────────────
# Minutes an unpaid order may hold its stock before the sweeper releases it.
ORDER_RESERVATION_MINUTES=30
