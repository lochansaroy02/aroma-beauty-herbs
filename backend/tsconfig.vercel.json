{
  // Type-check only, for the deploy build.
  //
  // The main tsconfig pins `rootDir` to ./src so `tsc` emits dist/ with a flat
  // layout. `api/` sits outside that root — Vercel compiles it itself with
  // esbuild, which ignores rootDir — so checking it needs a config without one.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src", "api"]
}
